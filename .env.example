# UGV Robot Configuration (.env)
# Copy this to .env and set your values. .env is gitignored.

# OpenAI-compatible LLM for chat/seek (required for AI features)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# Chat voice: external STT/TTS service URLs (optional, leave empty to disable)
# Example: http://<host>:<port>/stt or http://<host>:<port>/tts
# UGV_STT_URL=
# UGV_TTS_URL=

# RoArm USB ownership (optional, default: flask)
# Set to 'driver' if you want ROS 2 to own the CP2102 serial port
# UGV_ROARM_USB_OWNER=flask
